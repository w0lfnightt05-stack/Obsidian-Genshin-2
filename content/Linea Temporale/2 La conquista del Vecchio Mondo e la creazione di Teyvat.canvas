		{"id":"b858ed22d3906efb","type":"text","text":"[[Le Quattro Ombre]]","x":-179,"y":80,"width":224,"height":60},
		{"id":"4db64f0363e9e628","type":"text","text":"[[Ronova]], la Signora della Morte","x":-378,"y":220,"width":250,"height":77,"color":"1"},
		{"id":"b60a403a0686ab09","type":"text","text":"[[Istaroth]], la Signora del Tempo","x":380,"y":220,"width":250,"height":77,"color":"6"},
		{"id":"db3b6ca5fa3f7563","type":"text","text":"[[Naberius]], la Signora della Vita","x":-780,"y":220,"width":250,"height":77,"color":"5"},
		{"id":"305bd7fb2e2b58a4","type":"text","text":"[[Asmoday]], la Signora dello Spazio","x":-6,"y":220,"width":250,"height":77,"color":"2"},
		{"id":"af9b164148dd4703","type":"text","text":"Crea un'isola volante nel cielo e la chiama [[Celestia]] e avvolge il pianeta con un firmamento finto ([[Cielo Falso]])","x":-1525,"y":66,"width":360,"height":154},
		{"id":"34eb7d333b1b04db","type":"text","text":"Linee Geomantiche, che convergono nell'Irminsul (entrambi sono il luogo dove le anime sono immagazzinate)","x":-2105,"y":56,"width":280,"height":164},
		{"id":"cd54d64348c00147","type":"text","text":"Nato da un \"uovo\" che usa dopo la guerra per rimodellare il Vecchio Mondo in un nuovo mondo chiamato [[Teyvat]] ","x":-945,"y":-147,"width":330,"height":154},
		{"id":"fff2bb464eac6374","type":"text","text":"Utilizza il flogisto per creare i sette elementi e modifica [[Irminsul]] e la [[Linee Geomantiche]] dove scorrono naturalmente","x":-1525,"y":-147,"width":360,"height":154},
		{"id":"e84a0aa7bdb23212","type":"text","text":"Irminsul, la banca dati a forma di albero del mondo e l'ancora del destino la cui reincarnazione si è manifestata come [[Sua Eccellenza Maggiore Rukkhadevata]]","x":-2145,"y":-157,"width":360,"height":174},
		{"id":"5bcdd16c70e2dda4","x":-1165,"y":360,"width":340,"height":113,"type":"text","text":"Insieme, dopo 400 anni dal loro arrivo, crearono tutta la vita su Teyvat, inclusi gli Umani"}
	],
